import { TMP1 } from "../net/tmp1.js";
import { TMP2 } from "../net/tmp2.js";

export function TMP3() {

    return {
        KI: {
            base: TMP1.KI,
            rar: TMP2.KI,
            ratio: TMP1.KI.length / TMP2.KI.length
        },
        USER: {
            base: TMP1.USER,
            rar: TMP2.USER,
            ratio: TMP1.USER.length / TMP2.USER.length
        },
        RAW: {
            base: TMP1.RAW,
            rar: TMP2.RAW,
            ratio: TMP1.RAW.length / TMP2.RAW.length
        }
    };
}
